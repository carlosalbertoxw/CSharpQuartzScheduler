{
  "Routines": [
    {
      "Name": "RoutineJob",
      "Group": "Routines",
      "Service": "Example",
      "CronExpression": "0 * * ? * *",
      "TimeZone": "",
      "Enabled": true
    },
    {
      "Name": "DailyReport",
      "Group": "Reports",
      "Service": "DailyReport",
      "CronExpression": "0 0 7 ? * MON-FRI",
      "TimeZone": "America/Mexico_City",
      "Enabled": true
    },
    {
      "Name": "ReportCleanup",
      "Group": "Reports",
      "Service": "ReportCleanup",
      "CronExpression": "0 30 3 * * ?",
      "TimeZone": "",
      "Enabled": true
    }
  ],
  "Reports": {
    "Directory": "reports",
    "RetentionDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/scheduler-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "SourceContext = 'Quartz.Core.JobRunShell' and @mt like '%threw a JobExecutionException%'"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
